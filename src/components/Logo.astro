---
const html = 
(
" _   _           _                   _                 _                           _ _         "+
"| |_| |___ ___  | |_ _ _ ___ ___ ___| |_ _ ___ ___ ___| |_ _ ___ ___ ___   ___ ___| |_|___ ___ "+
"| . | | . | . |_|  _| | |  _| . | -_| | | |  _| . | -_| | | |  _| -_|   |_| . |   | | |   | -_|"+
"|___|_|___|_  |_|_| |___|_| |  _|___|_|___|_| |  _|___|_|___|_| |___|_|_|_|___|_|_|_|_|_|_|___|"+
"          |__/              |_|               |_|                                              "
).split('').map((c) => `<span class="block h-[1.3em]">${c.replaceAll(" ", "&nbsp;")}</span>`).join("");
// Split the ascii into spans so the banner always can take up the full width
// Chars per line is 95 used in the div below
---

<div id="banner" class="relative h-[7em] col-span-3 w-full overflow-x-hidden font-mono text-[10px] md:text-[13px] lg:text-[15px] leading-5">
    <div class=`absolute top-0 left-[50%] translate-x-[-50%] w-full grid grid-cols-[repeat(95,1fr)]` set:html={html}/>
</div>


